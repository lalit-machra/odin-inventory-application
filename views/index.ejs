<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/index.css" type="text/css">
    <title>Home</title>
  </head>
  <body>
    <div class="intro">
      <h1>Auto Inventory</h1>
      <p>All auto parts of all cars at one place</p>
    </div>
    <h2>Pick a category</h2>
    <div class="categories">
      <% categories.forEach((category) => { %>
        <a href="/parts/<%= category.tag %>" class="category">
          <img src="<%= category.image %>">
          <p><%= category.name %></p>
        </a>
      <% }) %>
    </div>
  </body>
</html>