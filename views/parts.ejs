<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/parts.css" type="text/css">
  <script src="/js/newPartDialog.js" defer></script>
</head>
<body>
  <h1><%= title %></h1>
  <div class="parts">
    <% parts.forEach(part => { %>
      <div class="part">
        <img src="<%= part.image %>">
        <span><%= part.name %></span>
        <span>Rs. <%= part.price %></span>
        <div>
          <button>Delete</button>
        </div>
      </div>
    <% }) %>
    <div class="part addNewPart">
      <img src="<%= addNew.image %>">
      <span><%= addNew.name %></span>
    </div>
  </div>
  <%- include("createPart", { part: rawPartCategory }) %>
</body>
</html>