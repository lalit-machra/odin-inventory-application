<!-- needs title and parts, where each part has a title and a price -->

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/parts.css" type="text/css">
</head>
<body>
  <h1><%= title %></h1>
  <div class="parts">
    <% parts.forEach(part => { %>
      <div class="part">
        <img src="<%= part.image %>">
        <span><%= part.name %></span>
        <span>Rs. <%= part.price %></span>
        <div>
          <button>Edit</button>
          <button>Delete</button>
        </div>
      </div>
    <% }) %>
    <div class="part">
      <img src="<%= addNew.img %>">
      <span><%= addNew.title %></span>
    </div>
  </div>
</body>
</html>